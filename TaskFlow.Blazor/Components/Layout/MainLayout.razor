@inherits LayoutComponentBase
@inject TaskFlow.Blazor.Services.AuthState AuthState

<div class="app-wrapper">

    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
<a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Alternar barra lateral">
                    <i class="bi bi-list"></i>
                </a>
            </li>
            <li class="nav-item d-none d-md-block">
                <a class="nav-link fw-semibold" href="/dashboard">
                    <i class="bi bi-kanban me-1" aria-hidden="true"></i>
                    TaskFlow
                </a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    @if (AuthState.IsAuthenticated)
                    {
                        <span class="nav-link">
                            <i class="bi bi-person-circle me-1"></i>
                            @AuthState.Email
                        </span>
                        <a class="nav-link" href="/login" @onclick="LogoutAsync">
                            <i class="bi bi-box-arrow-right me-1"></i> Salir
                        </a>
                    }
                    else
                    {
                        <a class="nav-link" href="login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                        </a>
                    }
                </li>
            </ul>
        </div>
    </nav>

    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a href="/dashboard" class="brand-link">
                <i class="brand-image bi bi-kanban rounded-circle opacity-75 shadow" aria-hidden="true"></i>
                <span class="brand-text fw-light">TaskFlow</span>
            </a>
        </div>

        <div class="sidebar-wrapper">
            <nav class="mt-2" aria-label="Navegación principal">
                <NavMenu />
            </nav>
        </div>
    </aside>

    <main class="app-main">
        <div class="app-content">
            <div class="container-fluid">
                @Body
            </div>
        </div>
    </main>

    <footer class="app-footer">
        <strong>Copyright &copy; 2026 TaskFlow.</strong> Todos los derechos reservados.
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error no controlado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthState.LoadAsync();
    }

    private async Task LogoutAsync()
    {
        await AuthState.LogoutAsync();
    }
}