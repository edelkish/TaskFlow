@inherits LayoutComponentBase
@inject TaskFlow.Blazor.Services.AuthState AuthState

<div class="app-wrapper">

    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
<a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Alternar barra lateral">
                    <i class="bi bi-list"></i>
                </a>
            </li>
            <li class="nav-item d-none d-md-block">
                <a class="nav-link fw-semibold" href="/dashboard">
                    <i class="bi bi-kanban me-1" aria-hidden="true"></i>
                    TaskFlow
                </a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                @if (AuthState.IsAuthenticated)
                {
                    <li class="nav-item dropdown user-menu">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle user-image" style="font-size: 1.6rem" aria-hidden="true"></i>
                            <span class="d-none d-md-inline">@AuthState.Email</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end" style="width: 320px; max-width: 320px">
                            <li class="user-header text-bg-primary">
                                <i class="bi bi-person-circle" style="font-size: 4rem" aria-hidden="true"></i>
                                <p>
                                    @AuthState.Email
                                    <small>@string.Join(", ", AuthState.Roles)</small>
                                </p>
                            </li>
                            <li class="user-footer">
                                @if (AuthState.IsAdmin)
                                {
                                    <a href="configuracion" class="btn btn-outline-secondary">
                                        <i class="bi bi-sliders me-1"></i> Configuración
                                    </a>
                                }
                                <a href="/login" class="btn btn-outline-danger float-end" @onclick="LogoutAsync">
                                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="login">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a href="/dashboard" class="brand-link">
                <i class="brand-image bi bi-kanban rounded-circle opacity-75 shadow" aria-hidden="true"></i>
                <span class="brand-text fw-light">TaskFlow</span>
            </a>
        </div>

        <div class="sidebar-search" role="search">
            <label for="sidebar-search-input" class="visually-hidden">Filtrar menú</label>
            <input type="search" id="sidebar-search-input" class="form-control form-control-sm"
                   placeholder="Filtrar menú…" autocomplete="off"
                   data-lte-toggle="sidebar-search" data-lte-target="#navigation" />
            <p class="fs-7 text-secondary mt-2 mb-0" data-lte-search-empty role="status" hidden>
                No hay coincidencias.
            </p>
        </div>

        <div class="sidebar-wrapper">
            <nav class="mt-2" aria-label="Navegación principal">
                <NavMenu />
            </nav>
        </div>
    </aside>

    <main class="app-main">
        <div class="app-content">
            <div class="container-fluid">
                @Body
            </div>
        </div>
    </main>

    <footer class="app-footer">
        <strong>Copyright &copy; 2026 TaskFlow.</strong> Todos los derechos reservados.
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error no controlado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthState.LoadAsync();
    }

    private async Task LogoutAsync()
    {
        await AuthState.LogoutAsync();
    }
}