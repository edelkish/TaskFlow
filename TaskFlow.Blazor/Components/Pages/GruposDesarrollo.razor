@page "/grupos-desarrollo"
@inherits TaskFlow.Blazor.Components.AuthenticatedPageBase
@inject TaskFlow.Blazor.Services.ApiClient Api

<PageTitle>Grupos de Desarrollo</PageTitle>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="bi bi-people-fill me-2"></i>Grupos de Desarrollo</h3>
                @if (AuthState.CanEditMasterData)
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => ShowCreate = true">
                        <i class="bi bi-plus-lg me-1"></i> Nuevo grupo
                    </button>
                }
            </div>
            <div class="card-body">
                <div class="callout callout-info">
                    <h5><i class="bi bi-info-circle me-1"></i> Para qué sirve</h5>
                    <p class="mb-0">
                        Un grupo de desarrollo agrupa a las personas que trabajan juntas. Cada
                        <a href="dashboard">proyecto</a> puede tener un grupo asignado, y la importación TXT
                        avisa (<span class="badge text-bg-warning">warning</span>, no bloquea) cuando el
                        <code>Dev</code> o el <code>QA</code> del bloque no pertenece al grupo del proyecto.
                    </p>
                </div>

                @if (!AuthState.CanEditMasterData)
                {
                    <div class="callout callout-warning">
                        <i class="bi bi-eye me-1"></i> Solo lectura: la escritura de maestros está reservada a
                        <code>Admin</code> y <code>Planificación</code>.
                    </div>
                }

                @if (IsLoading)
                {
                    <LoadingSpinner />
                }
                else
                {
                    @if (ShowCreate)
                    {
                        <div class="card card-outline card-primary mb-3">
                            <div class="card-body">
                                <h6 class="mb-3">Nuevo grupo de desarrollo</h6>
                                <form class="needs-validation" novalidate @ref="_createForm">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label">Nombre</label>
                                            <input type="text" class="form-control" maxlength="100" required @bind="NewName" />
                                            <div class="invalid-feedback">El nombre es obligatorio.</div>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label">Descripción</label>
                                            <input type="text" class="form-control" maxlength="500" @bind="NewDescription" />
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" disabled="@Busy" @onclick="CreateAsync">
                                                <i class="bi bi-check-lg me-1"></i> Guardar
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ShowCreate = false">Cancelar</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Descripción</th>
                                    <th style="width: 110px">Miembros</th>
                                    <th style="width: 100px">Proyectos</th>
                                    @if (AuthState.CanEditMasterData)
                                    {
                                        <th class="text-end" style="width: 200px">Acciones</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (Groups.Count == 0)
                                {
                                    <tr>
                                        <td colspan="@ColumnCount" class="text-center text-secondary">
                                            Todavía no hay grupos de desarrollo.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var g in Groups)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@g.Name</strong>
                                                @if (!g.IsActive)
                                                {
                                                    <span class="badge text-bg-secondary ms-1">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-secondary">@(g.Description ?? "—")</td>
                                            <td>
                                                <span class="badge text-bg-primary">@g.MemberCount</span>
                                            </td>
                                            <td>
                                                <span class="badge text-bg-info">@g.ProjectCount</span>
                                            </td>
                                            @if (AuthState.CanEditMasterData)
                                            {
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenMembers(g)">
                                                        <i class="bi bi-people me-1"></i> Miembros
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenEdit(g)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(g)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (MembersGroup != null)
                    {
                        <div class="card card-outline card-primary mt-3">
                            <div class="card-header">
                                <h6 class="card-title mb-0">
                                    Miembros de <strong>@MembersGroup.Name</strong>
                                </h6>
                            </div>
                            <div class="card-body">
                                <p class="text-secondary mb-2">
                                    Marque las personas que forman parte del grupo. La lista se reemplaza al guardar.
                                </p>
                                <div class="alert alert-info d-flex py-2" role="alert">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <div class="small">
                                        Cada persona pertenece a un <strong>único</strong> grupo de desarrollo.
                                        Las que ya están en otro grupo salen deshabilitadas: para moverlas,
                                        quítelas antes de su grupo actual. Si alguna ya figure en este y en
                                        otro, desmárcala aquí para dejarla solo en el suyo.
                                    </div>
                                </div>
                                <div class="row">
                                    @foreach (var p in People)
                                    {
                                        var foreign = ForeignGroupOf(p.Id);
                                        var isCurrent = SelectedMemberIds.Contains(p.Id);

                                        // Solo se bloquea a quien se PODRIA añadir. Un miembro
                                        // actual que ademas esta en otro grupo por datos
                                        // sucios tiene que poder quitarse, o el estado
                                        // inconsistente quedaria sin salida: aqui no se
                                        // puede desmarcar y en el otro grupo tampoco se
                                        // puede marcar.
                                        var locked = foreign != null && !isCurrent;

                                        <div class="col-md-3 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                       id="member-@p.Id"
                                                       checked="@isCurrent"
                                                       disabled="@locked"
                                                       @onchange="(e) => ToggleMember(p.Id, (bool?)e.Value == true)" />
                                                <label class="form-check-label @(locked ? "text-secondary" : "")" for="member-@p.Id">
                                                    @p.FullName
                                                </label>
                                                @* Se dice a que grupo pertenece, y no solo que esta ocupada:
                                                   sin el nombre el usuario no sabe adonde ir a sacarla. *@
                                                @if (foreign != null)
                                                {
                                                    <div class="small text-warning ms-4">
                                                        <i class="bi bi-lock-fill me-1"></i>
                                                        @if (isCurrent)
                                                        {
                                                            <span>También está en '@foreign.Value.Name'. Desmárcala para quitarla de aquí.</span>
                                                        }
                                                        else if (foreign.Value.Multiple)
                                                        {
                                                            <span>En varios grupos, entre ellos '@foreign.Value.Name'</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Ya está en '@foreign.Value.Name'</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="mt-3">
                                    <button class="btn btn-sm btn-primary" disabled="@Busy" @onclick="SaveMembersAsync">
                                        <i class="bi bi-check-lg me-1"></i> Guardar miembros
                                    </button>
                                    <button class="btn btn-sm btn-secondary ms-1" @onclick="CloseMembers">Cancelar</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (EditGroup != null)
                    {
                        <div class="card card-outline card-warning mt-3">
                            <div class="card-header">
                                <h6 class="card-title mb-0">Editar <strong>@EditGroup.Name</strong></h6>
                            </div>
                            <div class="card-body">
                                <form class="needs-validation" novalidate @ref="_editForm">
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label">Nombre</label>
                                            <input type="text" class="form-control" maxlength="100" required @bind="EditName" />
                                            <div class="invalid-feedback">El nombre es obligatorio.</div>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label">Descripción</label>
                                            <input type="text" class="form-control" maxlength="500" @bind="EditDescription" />
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" disabled="@Busy" @onclick="SaveEditAsync">
                                                <i class="bi bi-check-lg me-1"></i> Guardar
                                            </button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => EditGroup = null">Cancelar</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private ElementReference _createForm;
    private ElementReference _editForm;

    private List<TaskFlow.Application.DTOs.DevGroupDto> Groups { get; set; } = new();
    private List<TaskFlow.Application.DTOs.PersonDto> People { get; set; } = new();

    private bool ShowCreate { get; set; }
    private bool Busy { get; set; }

    private string NewName { get; set; } = string.Empty;
    private string? NewDescription { get; set; }

    private TaskFlow.Application.DTOs.DevGroupDto? MembersGroup { get; set; }
    private HashSet<Guid> SelectedMemberIds { get; set; } = new();

    /// <summary>Persona -> (grupo al que pertenece, si esta en varios a la vez).</summary>
    private readonly Dictionary<Guid, (string GroupName, bool Multiple)> _ownershipByPerson = new();

    private TaskFlow.Application.DTOs.DevGroupDto? EditGroup { get; set; }
    private string EditName { get; set; } = string.Empty;
    private string? EditDescription { get; set; }

    private int ColumnCount => AuthState.CanEditMasterData ? 5 : 4;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        LoadError = null;
        try
        {
            Groups = (await Api.GetDevGroupsAsync()) ?? new List<TaskFlow.Application.DTOs.DevGroupDto>();
            People = (await Api.GetPeopleAsync()) ?? new List<TaskFlow.Application.DTOs.PersonDto>();
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        if (!await Toast.ValidateFormAsync(_createForm))
        {
            return;
        }

        Busy = true;
        try
        {
            await Api.CreateDevGroupAsync(new TaskFlow.Application.DTOs.CreateDevGroupDto
            {
                Name = NewName.Trim(),
                Description = string.IsNullOrWhiteSpace(NewDescription) ? null : NewDescription.Trim()
            });
            ShowCreate = false;
            NewName = string.Empty;
            NewDescription = null;
            await Toast.SuccessAsync("Grupo creado correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private void OpenMembers(TaskFlow.Application.DTOs.DevGroupDto group)
    {
        MembersGroup = group;
        SelectedMemberIds = group.Members.Select(m => m.PersonId).ToHashSet();
        BuildOwnershipMap(group.Id);
    }

    private void CloseMembers()
    {
        MembersGroup = null;
        SelectedMemberIds = new HashSet<Guid>();
        _ownershipByPerson.Clear();
    }

    /// <summary>
    /// Mapa persona -> grupo al que ya pertenece, excluyendo el grupo que se esta
    /// editando para no marcar a sus miembros actuales como conflicto consigo mismos.
    ///
    /// La pagina ya carga los grupos con sus miembros, asi que el mapa se arma en memoria
    /// y no hace falta ninguna peticion extra ni ensuciar PersonDto con un dato que solo
    /// le interesa a esta vista.
    /// </summary>
    private void BuildOwnershipMap(Guid editingGroupId)
    {
        _ownershipByPerson.Clear();
        if (Groups == null)
        {
            return;
        }

        foreach (var g in Groups.Where(g => g.Id != editingGroupId))
        {
            foreach (var m in g.Members)
            {
                // Si una persona estuviera en dos grupos por datos previos, se conserva el
                // primero y se marca como conflicto multiple en lugar de ocultarlo.
                if (!_ownershipByPerson.ContainsKey(m.PersonId))
                {
                    _ownershipByPerson[m.PersonId] = (g.Name, false);
                }
                else
                {
                    _ownershipByPerson[m.PersonId] = (_ownershipByPerson[m.PersonId].GroupName, true);
                }
            }
        }
    }

    /// <summary>
    /// Grupo ajeno al que ya pertenece la persona, o null si esta libre. Se comprueba al
    /// cambiar el checkbox ademas de deshabilitarlo, porque un formulario se puede
    /// reenviar por teclado y saltarse el atributo disabled.
    /// </summary>
    private (string Name, bool Multiple)? ForeignGroupOf(Guid personId) =>
        _ownershipByPerson.TryGetValue(personId, out var owner)
            ? (owner.GroupName, owner.Multiple)
            : null;

    private void ToggleMember(Guid personId, bool selected)
    {
        // Regla de negocio: una persona pertenece a un unico grupo de desarrollo. El
        // servidor la vuelve a comprobar al guardar, esto solo evita llegar hasta alla.
        if (selected && ForeignGroupOf(personId) != null)
        {
            return;
        }

        if (selected)
        {
            SelectedMemberIds.Add(personId);
        }
        else
        {
            SelectedMemberIds.Remove(personId);
        }
    }

    private async Task SaveMembersAsync()
    {
        if (MembersGroup == null)
        {
            return;
        }

        // Sin comprobacion previa de conflictos aqui a proposito. El selector ya impide
        // anadir a quien esta en otro grupo, y si queda algun miembro inconsistente de
        // antes lo decide el servicio, que es quien tiene los datos frescos y un mensaje
        // mas exacto. Duplicar la regla en la UI solo anade un segundo sitio que se
        // puede desincronizar.
        Busy = true;
        try
        {
            await Api.SetDevGroupMembersAsync(MembersGroup.Id, SelectedMemberIds.ToList());
            await Toast.SuccessAsync("Miembros actualizados.");
            CloseMembers();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private void OpenEdit(TaskFlow.Application.DTOs.DevGroupDto group)
    {
        EditGroup = group;
        EditName = group.Name;
        EditDescription = group.Description;
    }

    private async Task SaveEditAsync()
    {
        if (EditGroup == null || !await Toast.ValidateFormAsync(_editForm))
        {
            return;
        }

        Busy = true;
        try
        {
            await Api.UpdateDevGroupAsync(EditGroup.Id, new TaskFlow.Application.DTOs.UpdateDevGroupDto
            {
                Name = EditName.Trim(),
                Description = string.IsNullOrWhiteSpace(EditDescription) ? null : EditDescription.Trim()
            });
            await Toast.SuccessAsync("Grupo actualizado.");
            EditGroup = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DeleteAsync(TaskFlow.Application.DTOs.DevGroupDto group)
    {
        try
        {
            await Api.DeleteDevGroupAsync(group.Id);
            await Toast.SuccessAsync("Grupo eliminado. Los proyectos quedan sin grupo asignado.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
    }
}
