@page "/"
@page "/login"
@layout AuthLayout
@using System.Diagnostics
@inject TaskFlow.Blazor.Services.AuthState AuthState
@inject TaskFlow.Blazor.Services.ApiClient Api
@inject TaskFlow.Blazor.Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>TaskFlow - Iniciar sesión</PageTitle>

<div class="login-box">
    <h1 class="login-logo">
        <a href="/"><b>Task</b>Flow</a>
    </h1>

    <div class="card">
        <div class="card-body login-card-body">

            @if (!IsRegister)
            {
                <p class="login-box-msg">Inicie sesión para comenzar su sesión</p>

                <form class="needs-validation" novalidate @ref="_loginForm" @onsubmit="LoginAsync" @onsubmit:preventDefault>
                    <div class="input-group mb-3 has-validation">
                        <input id="loginEmail" type="email" class="form-control" placeholder="Correo" required @bind="Email" />
                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca un correo electrónico válido.</div>
                    </div>

                    <div class="input-group mb-3 has-validation">
                        <input id="loginPassword" type="password" class="form-control" placeholder="Contraseña" required @bind="Password" />
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca la contraseña.</div>
                    </div>

                    <div class="row g-2 align-items-center">
                        <div class="col-8">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">Recuérdame</label>
                            </div>
                        </div>
                        <div class="col-4">
                            @* El boton lleva w-100 para no crecer al anadir el spinner: dentro de
                               un col-4 (~120px) el texto mas largo mas el spinner no caben, y como
                               no pueden partirse empujaban el boton fuera del card. El texto se
                               acorta ("Entrando..." en vez de "Autenticando...") y .login-btn
                               recorta en vez de desbordar si aun asi no cupiera. *@
                            <button type="submit" class="btn btn-primary w-100 login-btn" disabled="@Busy">
                                @if (Busy)
                                {
                                    <span class="login-btn-spinner" aria-hidden="true"></span>
                                }
                                <span class="login-btn-text">@(Busy ? "Entrando…" : "Entrar")</span>
                            </button>
                        </div>
                    </div>
                </form>

                <p class="mb-0">
                    <a href="#" @onclick="() => IsRegister = true" @onclick:preventDefault>Crear una cuenta nueva</a>
                </p>
            }
            else
            {
                <p class="login-box-msg">Crear una cuenta nueva</p>

                <form class="needs-validation" novalidate @ref="_registerForm" @onsubmit="RegisterAsync" @onsubmit:preventDefault>
                    <div class="input-group mb-3 has-validation">
                        <input id="registerName" type="text" class="form-control" placeholder="Nombre completo" required minlength="3" @bind="FullName" />
                        <div class="input-group-text">
                            <span class="bi bi-person-fill"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca su nombre (mínimo 3 caracteres).</div>
                    </div>

                    <div class="input-group mb-3 has-validation">
                        <input id="registerEmail" type="email" class="form-control" placeholder="Correo" required @bind="Email" />
                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca un correo electrónico válido.</div>
                    </div>

                    <div class="input-group mb-3 has-validation">
                        <input id="registerPassword" type="password" class="form-control" placeholder="Contraseña" required minlength="6" @bind="Password" />
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                        <div class="invalid-feedback">La contraseña debe tener al menos 6 caracteres.</div>
                    </div>

                    <div class="row g-2 align-items-center">
                        <div class="col-8">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                                <label class="form-check-label" for="agreeTerms">Acepto los términos</label>
                                <div class="invalid-feedback">Debe aceptar los términos.</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <button type="submit" class="btn btn-primary w-100 login-btn" disabled="@Busy">
                                @if (Busy)
                                {
                                    <span class="login-btn-spinner" aria-hidden="true"></span>
                                }
                                <span class="login-btn-text">@(Busy ? "Creando…" : "Crear cuenta")</span>
                            </button>
                        </div>
                    </div>
                </form>

                <p class="mb-0">
                    <a href="#" @onclick="() => IsRegister = false" @onclick:preventDefault>Ya tengo una cuenta</a>
                </p>
            }

        </div>
    </div>
</div>

@* Indicador de actividad: una barra delgada en el borde superior en vez de un
   overlay que oscureciera la pantalla. El overlay tapaba justo el formulario que el
   usuario está mirando mientras espera, y el fondo negro con desenfoque hacia la
   pagina entera, no solo al login. La barra deja ver el formulario y aun asi indica
   que la app está ocupada; el boton, con su spinner, da el detalle de que operacion
   es.

   Se renderiza desde Blazor y no con un onclick que lo muestre por JS. El onclick
   anterior lo activaba al pulsar el boton y ningun codigo lo ocultaba nunca: si el
   registro fallaba o el formulario no pasaba la validacion, el overlay se quedaba
   encima bloqueando la pantalla. Al atarlo a Busy, nace y muere con el mismo flag
   que gobierna el boton, asi que no puede quedar pegado. *@
@if (Busy)
{
    <div class="login-progress" role="status" aria-live="polite">
        <div class="login-progress-bar"></div>
        <span class="visually-hidden">@(IsRegister ? "Creando cuenta…" : "Autenticando…")</span>
    </div>
}

@code {
    // Instancia minima del overlay de carga. Ver WaitForMinimumAsync.
    private const int MinimumBusyMs = 400;

    private ElementReference _loginForm;
    private ElementReference _registerForm;

    private bool IsRegister { get; set; }
    private bool Busy { get; set; }
    private string FullName { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private async Task LoginAsync()
    {
        // El boton queda deshabilitado mientras Busy es true, pero eso no impide
        // pulsar Enter en el campo del correo, que dispara el submit otra vez y
        // mandaria un segundo POST a la API.
        if (Busy)
        {
            return;
        }

        if (!await Toast.ValidateFormAsync(_loginForm))
        {
            return;
        }

        var sw = Stopwatch.StartNew();
        Busy = true;

        // Blazor solo repinta al entrar en el handler y al salir de el. Como aqui ya
        // hubo un await antes (la validacion del formulario), el unico repintado
        // sincrono ya ocurrio con Busy en false, y el siguiente llega con Busy en
        // false otra vez, en el finally. Sin esta llamada el overlay y el spinner se
        // asignan pero nunca se dibujan, y no hay ningun error en consola porque el
        // codigo se ejecuta igual.
        StateHasChanged();

        try
        {
            if (await AuthState.LoginAsync(Email.Trim(), Password))
            {
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                await Toast.ErrorAsync("Credenciales incorrectas.");
            }
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            await WaitForMinimumAsync(sw);
            Busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        if (Busy)
        {
            return;
        }

        if (!await Toast.ValidateFormAsync(_registerForm))
        {
            return;
        }

        var sw = Stopwatch.StartNew();
        Busy = true;

        // Ver la nota en LoginAsync: sin StateHasChanged el overlay y el spinner se
        // asignan pero no llegan a pintarse, porque el unico repintado sincrono ya
        // ocurrio antes de poner Busy en true.
        StateHasChanged();

        try
        {
            var response = await Api.RegisterAsync(new TaskFlow.Application.DTOs.RegisterDto(Email.Trim(), Password, FullName.Trim()));
            if (response == null)
            {
                await Toast.ErrorAsync("No se pudo crear la cuenta.");
            }
            else if (await AuthState.LoginAsync(Email.Trim(), Password))
            {
                await Toast.SuccessAsync("Cuenta creada correctamente.");
                Nav.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            await WaitForMinimumAsync(sw);
            Busy = false;
        }
    }

    /// <summary>
    /// Mantiene el overlay visible al menos <see cref="MinimumBusyMs"/> aunque la
    /// respuesta sea inmediata. Sin esta espera, una autenticacion que se resuelve en
    /// decenas de milisegundos daria la sensacion de que no ha pasado nada.
    ///
    /// La espera va antes de limpiar Busy para que el overlay siga puesto, y dentro
    /// del finally para que tambien espere cuando la operacion falla rapido: en ese
    /// caso es el toast de error el que debe verse sin que lo tape el overlay.
    /// </summary>
    private static Task WaitForMinimumAsync(Stopwatch elapsed)
    {
        var remaining = MinimumBusyMs - (int)elapsed.ElapsedMilliseconds;
        return remaining > 0 ? Task.Delay(remaining) : Task.CompletedTask;
    }
}