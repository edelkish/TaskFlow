@page "/"
@page "/login"
@layout AuthLayout
@inject TaskFlow.Blazor.Services.AuthState AuthState
@inject TaskFlow.Blazor.Services.ApiClient Api
@inject TaskFlow.Blazor.Services.ToastService Toast
@inject NavigationManager Nav

<PageTitle>TaskFlow - Iniciar sesión</PageTitle>

<div class="login-box">
    <h1 class="login-logo">
        <a href="/"><b>Task</b>Flow</a>
    </h1>

    <div class="card">
        <div class="card-body login-card-body">

            @if (!IsRegister)
            {
                <p class="login-box-msg">Inicie sesión para comenzar su sesión</p>

                <form class="needs-validation" novalidate @ref="_loginForm" @onsubmit="LoginAsync" @onsubmit:preventDefault>
                    <div class="input-group mb-3 has-validation">
                        <input id="loginEmail" type="email" class="form-control" placeholder="Correo" required @bind="Email" />
                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca un correo electrónico válido.</div>
                    </div>

                    <div class="input-group mb-3 has-validation">
                        <input id="loginPassword" type="password" class="form-control" placeholder="Contraseña" required @bind="Password" />
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca la contraseña.</div>
                    </div>

                    <div class="row">
                        <div class="col-8">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">Recuérdame</label>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@Busy">
                                    @if (Busy)
                                    {
                                        <span class="spinner-border spinner-border-sm" role="status"></span>
                                        <span class="btn-text">Entrando...</span>
                                    }
                                    else
                                    {
                                        <span class="btn-text">Entrar</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <p class="mb-0">
                    <a href="#" @onclick="() => IsRegister = true" @onclick:preventDefault>Crear una cuenta nueva</a>
                </p>
            }
            else
            {
                <p class="login-box-msg">Crear una cuenta nueva</p>

                <form class="needs-validation" novalidate @ref="_registerForm" @onsubmit="RegisterAsync" @onsubmit:preventDefault>
                    <div class="input-group mb-3 has-validation">
                        <input id="registerName" type="text" class="form-control" placeholder="Nombre completo" required minlength="3" @bind="FullName" />
                        <div class="input-group-text">
                            <span class="bi bi-person-fill"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca su nombre (mínimo 3 caracteres).</div>
                    </div>

                    <div class="input-group mb-3 has-validation">
                        <input id="registerEmail" type="email" class="form-control" placeholder="Correo" required @bind="Email" />
                        <div class="input-group-text">
                            <span class="bi bi-envelope"></span>
                        </div>
                        <div class="invalid-feedback">Introduzca un correo electrónico válido.</div>
                    </div>

                    <div class="input-group mb-3 has-validation">
                        <input id="registerPassword" type="password" class="form-control" placeholder="Contraseña" required minlength="6" @bind="Password" />
                        <div class="input-group-text">
                            <span class="bi bi-lock-fill"></span>
                        </div>
                        <div class="invalid-feedback">La contraseña debe tener al menos 6 caracteres.</div>
                    </div>

                    <div class="row">
                        <div class="col-8">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="agreeTerms" required />
                                <label class="form-check-label" for="agreeTerms">Acepto los términos</label>
                                <div class="invalid-feedback">Debe aceptar los términos.</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary" disabled="@Busy"
                                        onclick="document.getElementById('loginOverlay').style.display='flex'">
                                    @(Busy ? "Creando..." : "Crear cuenta")
                                </button>
                            </div>
                        </div>
                    </div>
                </form>

                <p class="mb-0">
                    <a href="#" @onclick="() => IsRegister = false" @onclick:preventDefault>Ya tengo una cuenta</a>
                </p>
            }

        </div>
    </div>
</div>

<div id="loginOverlay" style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);display:none;align-items:center;justify-content:center;backdrop-filter:blur(2px);">
    <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
        <span class="visually-hidden">Procesando...</span>
    </div>
</div>

@code {
    private ElementReference _loginForm;
    private ElementReference _registerForm;

    private bool IsRegister { get; set; }
    private bool Busy { get; set; }
    private string FullName { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;

    private async Task LoginAsync()
    {
        if (!await Toast.ValidateFormAsync(_loginForm))
        {
            return;
        }

        Busy = true;
        try
        {
            if (await AuthState.LoginAsync(Email.Trim(), Password))
            {
                Nav.NavigateTo("/dashboard");
            }
            else
            {
                await Toast.ErrorAsync("Credenciales incorrectas.");
            }
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RegisterAsync()
    {
        if (!await Toast.ValidateFormAsync(_registerForm))
        {
            return;
        }

        Busy = true;
        try
        {
            var response = await Api.RegisterAsync(new TaskFlow.Application.DTOs.RegisterDto(Email.Trim(), Password, FullName.Trim()));
            if (response == null)
            {
                await Toast.ErrorAsync("No se pudo crear la cuenta.");
            }
            else if (await AuthState.LoginAsync(Email.Trim(), Password))
            {
                await Toast.SuccessAsync("Cuenta creada correctamente.");
                Nav.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }
}