@code {
    private sealed record Seccion(string Id, string Titulo, bool EsGrupo, string[] Palabras);

    private const string Parte3 = "p3";

    private static readonly Seccion[] _todas =
    [
        new("p1", "Parte 1 — La lógica de negocio", true, ["logica", "negocio", "resumen", "reglas"]),
        new("s1-1", "1.1 La regla que gobierna todo", false, ["maestros", "todo o nada", "rechazo", "rechazado", "registrador", "typo", "fantasma"]),
        new("s1-2", "1.2 Tres conceptos que se confundían ✅", false, ["conceptos", "roles", "cargo", "identity", "seeder", "personrole", "backfill", "curaduria"]),
        new("s1-3", "1.3 El grupo de desarrollo y por qué hoy solo avisa ✅", false, ["devgroup", "grupo de desarrollo", "warning", "personnotinde vgroup", "set null", "equipo"]),
        new("s1-4", "1.4 Período vs. Backlog: una sola tabla ✅", false, ["periodo", "backlog", "taskgroupid", "manual", "import", "kpi", "taskitem", "historico"]),
        new("s1-5", "1.5 Permisos: reportar no es curar ✅", false, ["permisos", "roles", "administrador", "planificacion", "teamlead", "developer", "maestros"]),
        new("s1-6", "1.6 El pipeline, etapa por etapa", false, ["pipeline", "parser", "validador", "escritura", "lote", "error", "warning", "finding", "importbatch", "rollback", "transaccion"]),
        new("p2", "Parte 2 — Ejemplo práctico", true, ["ejemplo", "practico", "archivo", "muestra", "casos"]),
        new("s2-1", "2.1 Estado inicial necesario", false, ["estado inicial", "sql", "periodos", "proyectos", "personas", "cargos", "devgroup", "core", "seed"]),
        new("s2-2", "2.2 El resultado: 4 bloques, 15 tareas", false, ["resultado", "bloques", "tareas", "planningtasks", "qa-only", "padres", "subs", "asignacion"]),
        new("s2-3", "2.3 Caso A — Dev fuera del equipo ✅", false, ["caso a", "warning", "personnotinde vgroup", "elizabeth", "se importa", "partial"]),
        new("s2-4", "2.4 Caso B — 409 y nada cambia", false, ["caso b", "409", "conflict", "personnotfound", "no se creo nada", "filepath", "auditoria", "importbatches", "rollback", "migel"]),
        new("s2-5", "2.5 Caso C — reimportar el mismo archivo", false, ["caso c", "reimportar", "idempotencia", "groupsupdated", "tasksremoved", "manual", "tasksimported"]),
        new("s2-6", "2.6 Caso D — crear un backlog", false, ["caso d", "backlog", "crear", "planningtasks", "migrar", "planningtasks/backlog", "filtro"]),
        new("s2-7", "2.7 Los endpoints", false, ["endpoints", "api", "dry-run", "validate", "200", "rest", "rutas", "planningtasks", "devgroups"]),
        new("p3", "Parte 3 — Estado de los pendientes", true, ["pendientes", "estado", "implementado", "migracion"]),
        new("s3-1", "Lo que sigue pendiente", false, ["pendiente", "tests", "curacion", "datos", "paquetes", "automapper", "nu1903", "nu1510", "historial", "lotes", "desalineado"]),
    ];

    private string _consulta = string.Empty;

    private HashSet<string> _visibles => string.IsNullOrEmpty(_consulta)
        ? [.. _todas.Select(s => s.Id)]
        :
        [
            .. _todas
                .Where(s => Tokens(_consulta).All(t => Coincide(s, t)))
                .Select(s => s.Id)
        ];

    private void Limpiar() => _consulta = string.Empty;

    /// <summary>
    /// El scroll lo hace taskflow.ayuda.scrollTo. El href queda como ancla real para
    /// que el enlace se pueda compartir, pero se cancela el evento: con base href="/"
    /// Blazor resolveria "#id" contra la raiz, el router matchearia "/" y llevaria a Login.
    /// </summary>
    private async Task IrA(string id) => await Js.InvokeVoidAsync("taskflow.ayuda.scrollTo", id);

    private static string[] Tokens(string consulta) => Normalizar(consulta)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries);

    private static bool Coincide(Seccion s, string token)
    {
        var titulo = Normalizar(s.Titulo);
        if (titulo.Contains(token))
        {
            return true;
        }

        foreach (var palabra in s.Palabras)
        {
            var normalizada = Normalizar(palabra);
            if (token.Length == 1 ? normalizada == token : normalizada.Contains(token))
            {
                return true;
            }
        }

        return false;
    }

    private static string Normalizar(string texto) => texto
        .ToLowerInvariant()
        .Replace("á", "a").Replace("é", "e").Replace("í", "i")
        .Replace("ó", "o").Replace("ú", "u").Replace("ü", "u")
        .Replace("ñ", "n");

    private static string Ancla(string id) => $"#{id}";
}
