@page "/periodos"
@inherits TaskFlow.Blazor.Components.AuthenticatedPageBase
@inject TaskFlow.Blazor.Services.ApiClient Api

<PageTitle>Periodos</PageTitle>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-calendar-month me-2"></i>Periodos de planificación</h3>
            </div>

            <div class="card-body">
                <form class="needs-validation" novalidate @ref="_createForm" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Año</label>
                            <input type="number" class="form-control" @bind="NewYear" min="2020" max="2100" required />
                            <div class="invalid-feedback">Indique el año (2020–2100).</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Mes</label>
                            <select class="form-select" @bind="NewMonth">
                                @for (var i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@(new System.Globalization.CultureInfo("es-ES").DateTimeFormat.GetMonthName(i))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" placeholder="Opcional" maxlength="100" @bind="NewName" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100" disabled="@Busy">
                                <i class="bi bi-plus-lg me-1"></i> Crear
                            </button>
                        </div>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead>
                            <tr>
                                <th>Periodo</th>
                                <th>Año</th>
                                <th>Mes</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Periods == null || Periods.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-secondary">No hay periodos creados.</td></tr>
                            }
                            else
                            {
                                @foreach (var p in Periods!.OrderByDescending(x => x.Year).ThenByDescending(x => x.Month))
                                {
                                    <tr>
                                        <td>@p.Name</td>
                                        <td>@p.Year</td>
                                        <td>@(new System.Globalization.CultureInfo("es-ES").DateTimeFormat.GetMonthName(p.Month))</td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-primary" href="grupos?periodo=@p.Id">
                                                <i class="bi bi-diagram-3 me-1"></i> Grupos
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private ElementReference _createForm;

    private int NewYear { get; set; } = DateTime.Today.Year;
    private int NewMonth { get; set; } = DateTime.Today.Month;
    private string NewName { get; set; } = string.Empty;
    private bool Busy { get; set; }
    private List<TaskFlow.Application.DTOs.PeriodDto>? Periods { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        LoadError = null;
        try
        {
            Periods = await Api.GetPeriodsAsync();
        }
        catch (Exception ex)
        {
            Periods = new();
            LoadError = ex.Message;
        }
    }

    private async Task CreateAsync()
    {
        if (!await Toast.ValidateFormAsync(_createForm))
        {
            return;
        }

        Busy = true;
        try
        {
            var name = !string.IsNullOrWhiteSpace(NewName)
                ? NewName.Trim()
                : $"{new System.Globalization.CultureInfo("es-ES").DateTimeFormat.GetMonthName(NewMonth)} {NewYear}";

            await Api.CreatePeriodAsync(new TaskFlow.Application.DTOs.CreatePeriodDto
            {
                Year = NewYear,
                Month = NewMonth,
                Name = name
            });
            NewName = string.Empty;
            await Toast.SuccessAsync("Periodo creado correctamente.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            Busy = false;
        }
    }
}