@page "/configuracion"
@inherits TaskFlow.Blazor.Components.AuthenticatedPageBase
@inject TaskFlow.Blazor.Services.ApiClient Api
@inject TaskFlow.Blazor.Services.ThemeState Theme

<PageTitle>Configuración del sistema</PageTitle>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="bi bi-sliders me-2"></i>Tema de la interfaz</h3>
            </div>

            <div class="card-body">
                @if (Error != null)
                {
                    <div class="alert alert-danger">@Error</div>
                }

                @if (!Busy)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Modo de color</label>
                            <select class="form-select" @bind="ColorMode">
                                <option value="light">Claro</option>
                                <option value="dark">Oscuro</option>
                            </select>
                            <div class="form-text">Define el tema de todo el sistema (login incluido).</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Color primario</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="color" class="form-control form-control-color" style="width: 3rem; height: 2.4rem;" @bind="Primary" />
                                <input type="text" class="form-control" @bind="Primary" maxlength="7" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Barra lateral</label>
                            <select class="form-select" @bind="SidebarBg">
                                @foreach (var bg in BackgroundOptions)
                                {
                                    <option value="@bg.Value">@bg.Label</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Encabezado</label>
                            <select class="form-select" @bind="HeaderBg">
                                @foreach (var bg in BackgroundOptions)
                                {
                                    <option value="@bg.Value">@bg.Label</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Pie de página</label>
                            <select class="form-select" @bind="FooterBg">
                                @foreach (var bg in BackgroundOptions)
                                {
                                    <option value="@bg.Value">@bg.Label</option>
                                }
                            </select>
                        </div>

                        <div class="col-12 mt-4">
                            <button class="btn btn-primary" disabled="@Busy" @onclick="SaveAsync">
                                <i class="bi bi-check-lg me-1"></i> Guardar configuración
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-secondary">
                        <i class="bi bi-arrow-repeat me-1"></i> Cargando configuración...
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private record BackgroundOption(string Value, string Label);

    private static readonly BackgroundOption[] BackgroundOptions =
    {
        new("bg-body", "Predeterminado"),
        new("bg-body-tertiary", "Gris claro"),
        new("bg-body-secondary", "Gris"),
        new("bg-white", "Blanco"),
        new("bg-dark", "Oscuro"),
        new("bg-primary", "Color primario"),
        new("bg-secondary", "Secundario"),
        new("bg-success", "Verde"),
        new("bg-warning", "Ámbar"),
        new("bg-danger", "Rojo"),
        new("bg-info", "Cian")
    };

    private bool Busy { get; set; } = true;
    private string? Error { get; set; }
    private string ColorMode { get; set; } = "light";
    private string SidebarBg { get; set; } = "bg-body-secondary";
    private string HeaderBg { get; set; } = "bg-body";
    private string FooterBg { get; set; } = "bg-body";
    private string Primary { get; set; } = "#467FD0";

    protected override async Task OnInitializedAsync()
    {
        await AuthState.LoadAsync();
        if (!AuthState.IsAdmin)
        {
            Nav.NavigateTo("/dashboard");
            return;
        }

        try
        {
            var settings = await Api.GetThemeSettingsAsync();
            if (settings != null)
            {
                ColorMode = settings.ColorMode;
                SidebarBg = settings.SidebarBg;
                HeaderBg = settings.HeaderBg;
                FooterBg = settings.FooterBg;
                Primary = settings.Primary;
            }
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SaveAsync()
    {
        Busy = true;
        Error = null;
        try
        {
            var hex = Primary.Trim();
            if (!hex.StartsWith('#'))
            {
                hex = "#" + hex;
            }
            if (hex.Length > 7)
            {
                hex = hex[..7];
            }

            await Theme.SaveAsync(new TaskFlow.Application.DTOs.UpdateThemeSettingsDto
            {
                ColorMode = ColorMode,
                SidebarBg = SidebarBg,
                HeaderBg = HeaderBg,
                FooterBg = FooterBg,
                Primary = hex
            });
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}